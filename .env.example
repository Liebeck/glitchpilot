# GlitchTip
GLITCHTIP_URL=https://your-glitchtip-instance.example.com
GLITCHTIP_TOKEN=your-api-token-here
GLITCHTIP_ORG=your-org-slug

# Azure OpenAI
OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
OPENAI_KEY=your-azure-openai-key
OPENAI_MODEL=gpt-4o

# GitHub
GITHUB_TOKEN=ghp_your-classic-pat-with-repo-scope
GITHUB_LABELS=glitchpilot
GITHUB_AGENT_LABEL=copilot
GITHUB_ASSIGN_TO=
GITHUB_COPILOT_MODEL=
# User whose personal Copilot plan is billed (default: owner of GITHUB_TOKEN)
GITHUB_BILLING_USER=

# SMTP / Mail
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
MAIL_FROM=glitchpilot@example.com
MAIL_RECIPIENTS=dev-team@example.com

# Projects (JSON array)
PROJECTS='[{"slug":"my-project","targetEnvironment":"Production","gitHubOwner":"your-org","gitHubRepo":"your-repo"}]'

# Filters / Tuning
MIN_OCCURRENCES=1
LOOKBACK_HOURS=24
EXCLUDE_TITLES=
EXCLUDE_IDS=

# Duplicate handling
# Merge errors of the same run that GlitchTip split into several groups (one GitHub issue / Copilot run)
MERGE_DUPLICATES_ENABLED=true
# Compare new errors with open GitHub issues / PRs before filing (skips re-fixing known problems)
DUPLICATE_SCAN_ENABLED=false
DUPLICATE_SCAN_MAX_ISSUES=50

# "Create GitHub issue anyway" button for dismissed transient errors (optional)
# URL of the deployed FileIssue function; the key signs the links (>= 32 chars, same value everywhere)
FILE_ISSUE_URL=
LINK_SIGNING_KEY=
LINK_EXPIRY_DAYS=14

# Usage tracking: pending runs + usage JSON in Azure Blob Storage.
# With storage, the triage email waits until Copilot finished (max REPORT_MAX_DELAY_MINUTES).
# The Azure Function falls back to AzureWebJobsStorage. Local: UseDevelopmentStorage=true (Azurite)
USAGE_STORAGE_CONNECTION=
USAGE_CONTAINER=glitchpilot-usage
REPORT_MAX_DELAY_MINUTES=120

# Azure Function (only needed for GlitchPilot.Functions)
# TRIAGE_SCHEDULE=0 0 5 * * *
